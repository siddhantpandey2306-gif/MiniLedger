# ==============================================================================
# MiniLedger Backend Environment Configuration Example
# Copy this file to backend/.env and update the values for your environment.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/miniledger

# JSON Web Token (JWT) Security Configuration
# In production, generate a secure random 256-bit string
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Mock OTP Verification Security Parameters
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
